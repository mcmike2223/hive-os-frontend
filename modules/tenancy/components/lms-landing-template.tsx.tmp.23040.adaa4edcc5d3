import {
  ArrowRight,
  BadgeCheck,
  BarChart3,
  BookOpenCheck,
  CalendarCheck2,
  Clock3,
  GraduationCap,
  Layers3,
  LibraryBig,
  LineChart,
  MonitorPlay,
  PlayCircle,
  Quote,
  ShieldCheck,
  Sparkles,
  Star,
  UsersRound,
} from "lucide-react";

import { Button } from "@/components/ui/button";
